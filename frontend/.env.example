# Copy to .env.local for local dev. NEXT_PUBLIC_* vars are exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Clerk authentication (Phase 2) ---
# Create an app at https://dashboard.clerk.com and copy the keys from "API keys".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth route locations + post-auth landing page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---------------------------------------------------------------------------
# In production (Phase 9) — set these in Vercel → Settings → Environment
# Variables, not in a file. Full walkthrough in docs/deployment.md.
# ---------------------------------------------------------------------------
#
# NEXT_PUBLIC_API_URL
#   The deployed API origin, e.g. https://fitmind-api.onrender.com — no
#   trailing slash. Because it is NEXT_PUBLIC_* it is baked into the client
#   bundle at BUILD time, not read at runtime: changing it in the Vercel
#   dashboard does nothing until you redeploy. That surprises people once.
#
#   Whatever you put here must also appear in the API's CORS_ORIGINS as the
#   other side of the pair — this is the origin the browser calls, that is the
#   list of origins the API answers.
#
# Clerk: pk_live_/sk_live_ come from a **production instance**, which is a
# separate instance from your development one — separate users, separate JWT
# template, separate webhook endpoint and signing secret. Nothing carries over,
# and a production frontend pointed at dev keys will authenticate against the
# wrong user table.
#
# A production instance also requires DNS records on a domain you own; Clerk
# will not issue live keys for a *.vercel.app URL. Staying on pk_test_ for a
# portfolio deployment is a legitimate choice — dev instances are rate-limited
# and show a development banner, but they work on any origin. Decide which you
# want before wiring the Stripe and Clerk webhooks, because their endpoints and
# secrets are per-instance.
#
# CLERK_SECRET_KEY has no NEXT_PUBLIC_ prefix for a reason: it is read only in
# server components and the proxy. Renaming it to NEXT_PUBLIC_ anything would
# publish it in the browser bundle.
