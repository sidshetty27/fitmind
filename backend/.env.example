# Copy to .env and fill in. .env is git-ignored.

# App
ENVIRONMENT=development

# Comma-separated origins allowed to call this API (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000

# ---------- Database (Phase 3) ----------
# Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL: runtime connection, use the **Transaction pooler** (port 6543).
#   Short-lived, per-request connections are exactly what it is built for.
# MIGRATION_DATABASE_URL: Alembic, use the **Direct connection** (port 5432).
#   DDL needs session-level state that the transaction pooler cannot hold.
#
# The scheme is normalised to postgresql+psycopg:// automatically — paste the
# URL exactly as Supabase gives it to you. URL-encode any special characters in
# the password (@ → %40, # → %23, etc.).
DATABASE_URL=postgresql://postgres.wgbdoaqoxwrtrlzllyqq:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres
MIGRATION_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wgbdoaqoxwrtrlzllyqq.supabase.co:5432/postgres

# Local Postgres instead of Supabase? One URL is enough — leave
# MIGRATION_DATABASE_URL unset and it falls back to DATABASE_URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitmind

# Log every SQL statement (useful while learning, far too noisy in production)
DB_ECHO=false

# ---------- Clerk authentication (Phase 4) ----------
# The backend verifies the Clerk session JWT the frontend sends — it does not call
# Clerk on the hot path.
#
# CLERK_ISSUER: your "Frontend API URL" from Clerk Dashboard → API keys, e.g.
#   https://your-app.clerk.accounts.dev (dev) or https://clerk.yourdomain.com (prod).
#   JWKS is fetched from {issuer}/.well-known/jwks.json automatically.
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_JWKS_URL: only set to override the derived URL above.
# CLERK_JWKS_URL=

# Optional hardening: restrict the token's `azp` (origin) claim to your frontends.
# Comma-separated; leave blank to disable the check.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Recommended: add an `email` (and optionally `name`) claim to your Clerk JWT
# template so the API can provision users with zero extra calls. If you do, the
# secret key below is not needed. See backend/README.md.
#
# CLERK_SECRET_KEY: only used as a fallback to fetch a user's email when the token
# carries none. Clerk Dashboard → API keys → Secret key (sk_...).
# CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CLERK_WEBHOOK_SECRET: Svix signing secret for the user-sync webhook. Create the
# endpoint in Clerk Dashboard → Webhooks (point it at /api/webhooks/clerk,
# subscribe to user.created/updated/deleted) and copy its "Signing Secret".
# CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- AI coach (Phase 7) ----------
# All three are optional. The coach computes its findings deterministically from
# logged workouts and only asks a model to phrase them, so with no key set the
# endpoint still returns findings — it just has no coaching voice.
#
# ANTHROPIC_API_KEY: console.anthropic.com → API keys. Billed per call.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# ANTHROPIC_MODEL: which model writes the coaching notes. Pinned in config rather
# than in code so `ai_analyses.model` records it and an upgrade leaves a trail.
# ANTHROPIC_MODEL=claude-opus-5
#
# COACH_WINDOW_WEEKS: how much history the coach reasons over. Matches the
# Progress page default so the two never disagree about what "recently" means.
# COACH_WINDOW_WEEKS=12

# ---------- Billing (Phase 8) ----------
# All optional. With these unset every user is free tier, the upgrade button is
# hidden rather than broken, and the webhook refuses deliveries — so you can run
# and test the whole app without a Stripe account. Use TEST mode keys until you
# genuinely intend to charge a real card.
#
# STRIPE_SECRET_KEY: Stripe Dashboard → Developers → API keys → Secret key.
# There is no publishable key here: Checkout is hosted, so the backend creates a
# session URL and the browser is redirected to it. Stripe.js never loads.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# STRIPE_PRICE_ID: the recurring Price the upgrade button buys. Create a Product
# with a monthly price, then copy the PRICE id (`price_...`) — not the product id
# (`prod_...`), which is the easiest thing to grab by mistake here.
# STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
#
# STRIPE_WEBHOOK_SECRET: signing secret for /api/webhooks/stripe. Locally, run
# `stripe listen --forward-to localhost:8000/api/webhooks/stripe` and use the
# whsec_ it prints — that secret is specific to the listen session, and differs
# from the one a Dashboard-created endpoint shows you.
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# FRONTEND_URL: where Stripe returns the user after checkout or the billing
# portal. Must be the app's real origin in production, or those redirects land
# on localhost.
# FRONTEND_URL=http://localhost:3000
#
# FREE_DAILY_AI_ANALYSES: coach runs a free account gets per rolling 24 hours.
# Premium is unlimited. Set to 0 to make the coach premium-only.
# FREE_DAILY_AI_ANALYSES=3
